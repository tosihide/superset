# =============================================================================
# Workspace-specific settings (generated by setup.sh)
# Append these to .env or source them before running dev commands.
# =============================================================================

# Ubuntu required settings
SKIP_ENV_VALIDATION=1
NO_SANDBOX=1

# Workspace Identity
SUPERSET_WORKSPACE_NAME="superset"
# Adjust this to your local path
SUPERSET_HOME_DIR="/path/to/superset/superset-dev-data"

# Workspace Database (Neon Branch)
# Leave empty for SQLite-only mode (Neon Free)
# NEON_BRANCH_ID=
# DIRECT_URL=

# Workspace Electric SQL (Docker)
# Only used with Neon Pro + Electric SQL
ELECTRIC_PORT="3009"
ELECTRIC_URL="http://localhost:3009/v1/shape"

# Workspace Ports (allocated from SUPERSET_PORT_BASE=3000, range=20)
SUPERSET_PORT_BASE="3000"
WEB_PORT="3000"
API_PORT="3001"
MARKETING_PORT="3002"
ADMIN_PORT="3003"
DOCS_PORT="3004"
DESKTOP_VITE_PORT="3005"
DESKTOP_NOTIFICATIONS_PORT="3006"
STREAMS_PORT="3007"
STREAMS_INTERNAL_PORT="3008"
ELECTRIC_PORT="3009"
CADDY_ELECTRIC_PORT="3010"
CODE_INSPECTOR_PORT="3011"
DESKTOP_AUTOMATION_PORT="3012"
WRANGLER_PORT="3013"

# Cross-app URLs (overrides from root .env)
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_WEB_URL="http://localhost:3000"
NEXT_PUBLIC_MARKETING_URL="http://localhost:3002"
NEXT_PUBLIC_ADMIN_URL="http://localhost:3003"
NEXT_PUBLIC_DOCS_URL="http://localhost:3004"
NEXT_PUBLIC_DESKTOP_URL="http://localhost:3005"
EXPO_PUBLIC_WEB_URL="http://localhost:3000"
EXPO_PUBLIC_API_URL="http://localhost:3001"

# Streams URLs (overrides from root .env)
PORT="3007"
STREAMS_URL="http://localhost:3007"
NEXT_PUBLIC_STREAMS_URL="http://localhost:3007"
EXPO_PUBLIC_STREAMS_URL="http://localhost:3007"
STREAMS_INTERNAL_URL="http://127.0.0.1:3008"

# Electric URLs (overrides from root .env)
ELECTRIC_URL="http://localhost:3009/v1/shape"
# Caddy HTTPS proxy for HTTP/2 (avoids browser 6-connection limit with Electric SSE streams)
NEXT_PUBLIC_ELECTRIC_URL="https://localhost:3010"
NEXT_PUBLIC_ELECTRIC_PROXY_URL="https://localhost:3010"
