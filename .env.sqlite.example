
# =============================================================================
# テンプレート: デスクトップの「ローカル SQLite」前提で作業する場合
#
# 使い方:
#   cp .env.sqlite.example .env
#
# 重要（Neon と SQLite の関係）:
# - このリポジトリでは「サーバー側のスキーマ」(@superset/db) は Neon/PostgreSQL 用。
#   ルート .env で SQLite ファイルパスに切り替える仕組みはない。
# - デスクトップアプリのオフライン用 DB は better-sqlite3 で開き、通常は次のいずれか:
#     ~/.superset/local.db
#     ~/.superset-{ワークスペース名}/local.db
#   実装: apps/desktop/src/main/lib/local-db/index.ts
# - したがって「SQLite 用」のテンプレートとは、Neon(DATABASE_URL) をまだ埋めず
#   デスクトップやビルドだけ試すときの出発点として使う。必要なら後から .env.neon.example
#   の値を追記する。
#
# 未設定のまま各パッケージの env 検証で止まる場合は SKIP_ENV_VALIDATION を使う
# (README の Option B と同様)。本番や API 開発では適切な値を設定し、通常は検証を有効に保つこと。
# =============================================================================

SKIP_ENV_VALIDATION=1

# -----------------------------------------------------------------------------
# Neon（API/Web を起動する場合は .env.neon.example を参照して実値を入れる）
# デスクトップのみのときは空のまままたは下記のダミー URL は使わない方がよい。
# -----------------------------------------------------------------------------
NEON_ORG_ID=
NEON_PROJECT_ID=
NEON_API_KEY=
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# -----------------------------------------------------------------------------
# Cross-App URLs (Local Dev)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3003
NEXT_PUBLIC_MARKETING_URL=http://localhost:3002
NEXT_PUBLIC_DOCS_URL=http://localhost:3004

# -----------------------------------------------------------------------------
# Better Auth
# -----------------------------------------------------------------------------
BETTER_AUTH_SECRET=
NEXT_PUBLIC_COOKIE_DOMAIN=localhost

# -----------------------------------------------------------------------------
# OAuth Credentials (for Desktop App direct auth)
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GH_CLIENT_ID=
GH_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# GitHub App Credentials
# -----------------------------------------------------------------------------
GH_APP_ID=
GH_APP_PRIVATE_KEY=
GH_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Blob Storage
# -----------------------------------------------------------------------------
BLOB_READ_WRITE_TOKEN=

# -----------------------------------------------------------------------------
# PostHog Analytics (Local Dev)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=
POSTHOG_API_KEY=
POSTHOG_PROJECT_ID=

# -----------------------------------------------------------------------------
# Freestyle
# -----------------------------------------------------------------------------
FREESTYLE_API_KEY=

# -----------------------------------------------------------------------------
# Sentry Error Tracking
# -----------------------------------------------------------------------------
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_DSN_WEB=
NEXT_PUBLIC_SENTRY_DSN_MARKETING=
NEXT_PUBLIC_SENTRY_DSN_ADMIN=
NEXT_PUBLIC_SENTRY_DSN_DOCS=
NEXT_PUBLIC_SENTRY_DSN_API=
SENTRY_DSN_DESKTOP=

# -----------------------------------------------------------------------------
# Resend (Email)
# -----------------------------------------------------------------------------
RESEND_API_KEY=

# -----------------------------------------------------------------------------
# Stripe Billing
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Upstash Redis & QStash
# -----------------------------------------------------------------------------
KV_REST_API_URL=
KV_REST_API_TOKEN=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# MCP API Key for Claude Code
SUPERSET_MCP_API_KEY=
